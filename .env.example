# Copy to .env (`make setup` does this). Never commit .env.
# Every value has a working default; set only what you need.

# ── PostgreSQL (docker compose) ──────────────────────────────────────────────
POSTGRES_USER=pmnews
POSTGRES_PASSWORD=pmnews-local
POSTGRES_DB=pmnews
# docker compose builds DATABASE_URL from the three values above. Set it only when
# running the API on your host, e.g. with `make dev`:
# DATABASE_URL=postgresql+asyncpg://pmnews:pmnews-local@localhost:5432/pmnews

# ── LLM (OpenRouter) ─────────────────────────────────────────────────────────
# Needed only for generating articles. Without it the generate buttons return 503.
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v3.2
LLM_WEB_SEARCH=true

# Who may trigger paid LLM calls: disabled | open | token.
# "open" is for local development only; public deployments use "token".
GENERATION_MODE=open
ADMIN_TOKEN=
MAX_UPDATES_PER_REQUEST=5

# ── Data sources ─────────────────────────────────────────────────────────────
# Polymarket is not available in Estonia and is off by default.
POLYMARKET_ENABLED=false
FETCH_INTERVAL_MINUTES=30

# ── Frontend ─────────────────────────────────────────────────────────────────
# URL the browser uses to reach the API.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
